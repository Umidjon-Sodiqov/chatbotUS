# --- Majburiy sozlamalar ---

# BotFather dan olingan bot token
BOT_TOKEN=your_bot_token_here

# Sizning Telegram ID ingiz (admin)
ADMIN_ID=123456789

# --- Render.com sozlamalari ---

# Render tomonidan berilgan URL (masalan: https://my-bot.onrender.com)
# Bo sh qolsa, self-ping ishlamaydi (mahalliy ishga tushirishda shart emas)
RENDER_URL=https://your-bot-name.onrender.com

# Self-ping oraligi (soniyada). Default: 600 = 10 daqiqa
# Render 15 daqiqa faoliyat bolmasa sleep ga tushadi -- 10 daqiqa yetarli
SELF_PING_INTERVAL=600

# Render avtomatik beradi (ozgartirmang)
PORT=8080

# --- Ixtiyoriy sozlamalar ---

# Ish vaqti soatlari (UTC+5, Toshkent)
WORK_START_HOUR=9
WORK_END_HOUR=23

# Rate limit (spam himoya) -- hozir ochirilgan
RATE_LIMIT_MAX=5
RATE_LIMIT_SEC=60
